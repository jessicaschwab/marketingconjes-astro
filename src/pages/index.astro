---
import '../styles/global.css';
const title = "Marketingconjes | Soluciones Digitales";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-50 text-neutral-900 font-sans antialiased selection:bg-neutral-900 selection:text-white">
    
    <!-- Cabecera Limpia -->
    <header class="py-6 px-8 md:px-16 flex justify-between items-center border-b border-neutral-200 bg-white">
      <h2 class="text-base font-semibold tracking-tight">Marketingconjes</h2>
      <nav class="flex gap-6 text-sm text-neutral-600">
        <a href="#servicios" class="hover:text-neutral-900 transition-colors">Servicios</a>
        <a href="#contacto" class="hover:text-neutral-900 transition-colors">Contacto</a>
      </nav>
    </header>

    <!-- Sección Hero Minimalista -->
    <main class="max-w-2xl mx-auto px-6 pt-24 pb-16 text-center">
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-neutral-900 mb-6">
        Diseño web y estrategias digitales con claridad.
      </h1>
      <p class="text-lg text-neutral-600 mb-10 max-w-lg mx-auto leading-relaxed">
        Ayudamos a potenciar tu marca con desarrollos modernos, rápidos y adaptados a tus necesidades.
      </p>
      <a href="#contacto" class="inline-flex items-center justify-center bg-neutral-900 text-white px-6 py-3 rounded-md text-sm font-medium hover:bg-neutral-800 transition-colors">
        Hablemos
      </a>
    </main>

  </body>
</html>