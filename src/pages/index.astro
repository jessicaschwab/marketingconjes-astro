        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 text-left">
          <div class="bg-neutral-50 p-4 rounded-lg border border-neutral-200">
            <span class="text-orange-600 font-bold text-sm block mb-1">01. WhatsApp</span>
