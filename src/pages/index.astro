      <div class="text-center mb-16">
        <span class="text-xs font-semibold tracking-widest uppercase bg-orange-100 text-orange-700 px-3 py-1 rounded-full mb-3 inline-block">
          Formación Práctica
        </span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900 mb-3">Capacitaciones para Emprendedores y Empresas</h2>
