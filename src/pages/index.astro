    </footer>
<!-- Aviso previo e interactivo de IA y Privacidad -->
<div class="p-3 bg-gray-50 border-b border-gray-200 text-xs text-gray-600 rounded-t-lg">
  <p class="font-medium text-gray-800 mb-1">🤖 Asistente Automatizado con Inteligencia Artificial</p>
  <p class="mb-1">
    Estás interactuando con un sistema de IA procesado mediante Groq. Los datos personales que compartas se utilizarán exclusivamente para gestionar tu consulta sobre nuestros servicios.
  </p>
  <p class="mb-1">
    Podés ejercer tus derechos de acceso, rectificación, actualización y supresión escribiendo a 
    <a href="mailto:info@marketingconjes.ar" class="text-orange-600 underline font-medium"> info@marketingconjes.ar</a>.
  </p>
  <p class="text-gray-500 mt-1">
    Al utilizar este chat, aceptás nuestras <a href="/politica-privacidad" class="text-orange-600 underline">políticas de uso de IA</a>.
  </p>
</div>

<!-- Asistente de IA Flotante -->
    <div id="gemini-chat-widget">
        <div id="gemini-chat-header" onclick="toggleChat()">💬 Asistente IA</div>
        <div id="gemini-chat-body" style="display: none;">
            <div id="gemini-chat-messages">
                <div class="msg-bot"><b>Bot:</b> ¡Hola! ¿En qué puedo ayudarte hoy?</div>
            </div>
            <div id="gemini-chat-input-area">
                <input type="text" id="gemini-user-input" placeholder="Escribe tu pregunta..." onkeypress="handleKeyPress(event)">
                <button onclick="sendGeminiMessage()">Enviar</button>
            </div>
        </div>
    </div>

    <style>
    #gemini-chat-widget { position: fixed; bottom: 20px; left: 20px; z-index: 9999; font-family: sans-serif; }
    #gemini-chat-header { background: #f97316; color: white; padding: 12px 18px; border-radius: 8px; cursor: pointer; font-weight: bold; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    #gemini-chat-body { width: 300px; height: 400px; background: white; border: 1px solid #e5e7eb; border-radius: 8px; display: flex; flex-direction: column; box-shadow: 0 5px 15px rgba(0,0,0,0.2); margin-bottom: 10px; }
    #gemini-chat-messages { flex: 1; padding: 10px; overflow-y: auto; font-size: 14px; display: flex; flex-direction: column; gap: 8px; }
    #gemini-chat-input-area { display: flex; padding: 10px; border-top: 1px solid #eee; background: #f9f9f9; }
    #gemini-user-input { flex: 1; padding: 8px; border: 1px solid #ccc; border-radius: 4px; outline: none; font-size: 14px; }
    #gemini-chat-widget button { background: #f97316; color: white; border: none; padding: 8px 12px; margin-left: 5px; border-radius: 4px; cursor: pointer; font-weight: bold; }
    .msg-user { background: #ffedd5; padding: 6px 10px; border-radius: 6px; align-self: flex-end; max-width: 80%; word-break: break-word; color: #9a3412; font-size: 13px; }
    .msg-bot { background: #f3f4f6; padding: 6px 10px; border-radius: 6px; align-self: flex-start; max-width: 80%; word-break: break-word; color: #1f2937; font-size: 13px; }
    </style>

    <script is:inline>
    function toggleChat() {
        var body = document.getElementById('gemini-chat-body');
        body.style.display = body.style.display === 'none' ? 'flex' : 'none';
    }
    function handleKeyPress(e) {
        if (e.key === 'Enter') sendGeminiMessage();
    }
    function sendGeminiMessage() {
        var input = document.getElementById('gemini-user-input');
        var message = input.value.trim();
        if (!message) return;

        var messagesDiv = document.getElementById('gemini-chat-messages');
        messagesDiv.innerHTML += '<div class="msg-user"><b>Tú:</b> ' + escapeHtml(message) + '</div>';
        input.value = '';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: message })
        })
        .then(res => res.json())
        .then(res => {
            if(res.success) {
                messagesDiv.innerHTML += '<div class="msg-bot"><b>Bot:</b> ' + escapeHtml(res.reply) + '</div>';
            } else {
                messagesDiv.innerHTML += '<div class="msg-bot" style="color:red;"><b>' + escapeHtml(res.message || 'Error desconocido') + '</div>';
            }
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        })
        .catch(err => {
            messagesDiv.innerHTML += '<div class="msg-bot" style="color:red;"><b>Error de red al conectar.</b></div>';
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        });
    }
    function escapeHtml(text) {
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, function(m) { return map[m]; });
    }
    </script>
    <WhatsAppButton phone="5492974126974" message="Hola Jes, quiero consultar por tus servicios de marketing." />
  </body>
</html>