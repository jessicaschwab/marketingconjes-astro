                    tip: "Permite la atención a ritmos de aprendizaje diversos."
                },
                adaptacion: {
                    prompt: "Crea un apoyo visual en texto para explicar la división por una cifra usando el método de restas sucesivas para un estudiante que requiere apoyo en memoria de trabajo.",
                    tip: "Desglosa la complejidad procedimental."
                }
            },
            historia: {
                cuento: {
                    prompt: "Escribe una carta ficticia en primera persona de un niño de 1810 relatando cómo era un día en la época colonial para leer con alumnos de 4° grado en la semana de mayo.",
                    tip: "Genera empatía e inmersión histórica."
                },
                rubrica: {
                    prompt: "Crea una rúbrica para evaluar una exposición grupal sobre Geografía de Argentina (Relieve y Climas) en 6° grado.",
                    tip: "Clara y transparente para comunicar a las familias."
                },
                actividad: {
                    prompt: "Diseña un juego de 'Verdadero o Falso con justificación' sobre los Pueblos Originarios de Argentina para 5° grado.",
                    tip: "Promueve el pensamiento crítico y la argumentación."
                },
                adaptacion: {
                    prompt: "Resume los hechos principales del 25 de Mayo en 4 oraciones clave escritas en lenguaje claro y directo para un alumno de inclusión en 4° grado.",
                    tip: "Síntesis didáctica respetuosa."
                }
            }
        };

        function updatePromptSim() {
            const materiaEl = document.getElementById('sim-materia');
            const objetivoEl = document.getElementById('sim-objetivo');
            const outputEl = document.getElementById('sim-output');
            const tipEl = document.getElementById('sim-tip');

            if (!materiaEl || !objetivoEl || !outputEl || !tipEl) return;

            const materia = materiaEl.value;
            const objetivo = objetivoEl.value;

            if (promptData[materia] && promptData[materia][objetivo]) {
                const current = promptData[materia][objetivo];
                outputEl.innerText = current.prompt;
                tipEl.innerText = current.tip;
            }
        }

        window.onload = function() {
            updatePromptSim();
        }
    </script>
</body>
</html>