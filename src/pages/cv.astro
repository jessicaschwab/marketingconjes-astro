---
import '../styles/global.css';
const title = "Jessica Fernanda Schwab | Especialista en IA Educativa & Analista Programadora";
const description = "CV interactivo de Jessica Schwab, Especialista en IA Educativa, Profesora de Informática y Analista Programadora.";
---

<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        },
                        tech: {
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(229, 231, 235, 0.9);
            color: #1e293b;
        }
        .dark .glass-panel {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(51, 65, 85, 0.8);
            color: #f8fafc;
        }
        .gradient-text {
            background: linear-gradient(135deg, #f97316 0%, #10b981 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-300 min-h-screen">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 border border-slate-700 pointer-events-none">
        <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span id="toast-message" class="text-sm font-medium">Copiado al portapapeles</span>
    </div>

    <!-- Sticky Navigation Header -->
    <header class="sticky top-0 z-40 w-full glass-panel transition-all">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 group">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-orange-500 to-emerald-500 flex items-center justify-center text-white font-bold text-lg shadow-md group-hover:scale-105 transition-transform">
                    JS
                </div>
                <div>
                    <span class="font-bold text-base tracking-tight block leading-none">Jessica Schwab</span>
                    <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">IA & Pedagógica Digital</span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
                <a href="/" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Volver al Inicio</a>
                <a href="#perfil" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Perfil</a>
                <a href="#experiencia" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Experiencia</a>
                <a href="#simulador" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
                    Demostración Aula
                </a>
                <a href="#habilidades" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Habilidades & GitHub</a>
                <a href="#contacto" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">Contacto</a>
            </nav>

            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Theme Toggle Button -->
                <button id="theme-toggle" class="p-2 rounded-xl bg-slate-200/80 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-700 transition-all" title="Cambiar Tema">
                    <svg id="theme-icon-dark" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    <svg id="theme-icon-light" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>

                <!-- CTA Direct Contact -->
                <a href="mailto:schwabjessica@gmail.com" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-xl bg-orange-600 hover:bg-orange-700 text-white shadow-md shadow-orange-500/20 transition-all hover:scale-[1.02]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    Postulante Docente
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-12 space-y-12 sm:space-y-16 overflow-x-hidden">

        <!-- Hero Section -->
        <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-orange-950 via-slate-900 to-emerald-950 text-white p-6 sm:p-10 lg:p-12 shadow-2xl border border-orange-500/20">
            <div class="absolute -top-24 -right-24 w-96 h-96 bg-orange-500/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 grid md:grid-cols-12 gap-8 items-center">
                <div class="md:col-span-8 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-400/30 text-emerald-300 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Capacitadora Docente de Inteligencia Artificial para Primaria
                    </div>

                    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
                        Transformando la Educación Primaria mediante <span class="bg-gradient-to-r from-emerald-400 to-orange-300 bg-clip-text text-transparent">IA & Pedagogía Práctica</span>
                    </h1>

                    <p class="text-slate-300 text-xs sm:text-base leading-relaxed max-w-2xl">
                        Hola, soy <strong class="text-white">Jessica Schwab</strong>. Uno el mundo técnico de la <strong>programación y desarrollo de software</strong> con más de 15 años de experiencia docente. Capacito a maestros de educación primaria para integrar la IA de forma sencilla, aligerar su carga administrativa y enriquecer el aprendizaje en el aula.
                    </p>

                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
                        <div class="p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
                            <div class="text-lg sm:text-2xl font-bold text-emerald-400">+15 Años</div>
                            <div class="text-[11px] sm:text-xs text-slate-400">Trayectoria Educativa</div>
                        </div>
                        <div class="p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
                            <div class="text-lg sm:text-2xl font-bold text-orange-300">Analista Prog.</div>
                            <div class="text-[11px] sm:text-xs text-slate-400">Univ. Patagonia SJB</div>
                        </div>
                        <div class="p-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm col-span-2 sm:col-span-1">
                            <div class="text-lg sm:text-2xl font-bold text-amber-300">IA Generativa</div>
                            <div class="text-[11px] sm:text-xs text-slate-400">Prompt Eng. & Gemas</div>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-3 pt-4">
                        <a href="mailto:schwabjessica@gmail.com?subject=Propuesta%20Clases%20Virtuales%20IA%20Docentes%20Primaria" class="px-5 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-600 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 hover:scale-[1.02] transition-all flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Postularme para dar Clases
                        </a>

                        <a href="https://github.com/jessicaschwab" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-xs sm:text-sm border border-white/25 hover:scale-[1.02] transition-all flex items-center gap-2">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                            Repositorio GitHub
                        </a>

                        <button onclick="copyToClipboard('schwabjessica@gmail.com', 'Email copiado exitosamente')" class="px-4 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-slate-200 hover:text-white font-medium text-xs sm:text-sm border border-white/20 transition-all flex items-center gap-2" title="Copiar Email">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            Copiar Email
                        </button>
                    </div>
                </div>

                <div class="md:col-span-4 flex justify-center">
                    <div class="relative group w-full max-w-xs">
                        <div class="absolute -inset-1 bg-gradient-to-r from-orange-500 to-emerald-500 rounded-3xl blur opacity-75 group-hover:opacity-100 transition duration-500"></div>
                        <div class="relative p-6 bg-slate-900 rounded-3xl border border-slate-800 text-center space-y-4">
                            <div class="relative w-28 h-28 mx-auto rounded-full overflow-hidden ring-4 ring-orange-500/30 p-1 bg-slate-800">
                                <img src="https://github.com/jessicaschwab.png" onerror="this.onerror=null; this.src='https://placehold.co/400x400/1e293b/ffffff?text=Jessica+Schwab';" alt="Jessica Schwab" class="w-full h-full object-cover rounded-full">
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white">Jessica F. Schwab</h3>
                                <p class="text-xs text-orange-400 font-semibold tracking-wide uppercase mt-1">Profesora & Analista</p>
                                <p class="text-xs text-slate-400 mt-2">Comodoro Rivadavia, Chubut</p>
                            </div>
                            <div class="pt-3 border-t border-slate-800 flex justify-center gap-3">
                                <a href="https://linkedin.com/in/schwabjessicafernanda" target="_blank" class="p-2 rounded-lg bg-slate-800 hover:bg-orange-600 text-slate-300 hover:text-white transition-colors" title="LinkedIn">
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.239-2.762-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                                </a>
                                <a href="https://github.com/jessicaschwab" target="_blank" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors" title="GitHub">
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                                </a>
                                <a href="tel:2974189847" class="p-2 rounded-lg bg-slate-800 hover:bg-emerald-600 text-slate-300 hover:text-white transition-colors" title="Teléfono">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Dynamic Proposal & Pedagogical Approach -->
        <section id="perfil" class="space-y-6">
            <div class="flex items-center gap-3">
                <div class="p-2 rounded-xl bg-orange-500/10 text-orange-600 dark:text-orange-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 01-2 2h-0a2 2 0 01-2-2v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                </div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold tracking-tight">Propuesta Pedagógica para Docentes de Primaria</h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Por qué mi perfil técnico y docente es la combinación ideal para este dictado</p>
                </div>
            </div>

            <div class="grid md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="p-6 rounded-2xl glass-panel shadow-sm hover:shadow-md transition-shadow space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold">
                        01
                    </div>
                    <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">Empatía y Lenguaje Docente</h3>
                    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                        Como Profesora de Informática formada en Consudec, traduzco conceptos complejos de IA a explicaciones cercanas, sin modismos crípticos de programación. Comprendo la realidad del aula primaria.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="p-6 rounded-2xl glass-panel shadow-sm hover:shadow-md transition-shadow space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-orange-500/10 text-orange-700 dark:text-orange-300 flex items-center justify-center font-bold">
                        02
                    </div>
                    <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">Respaldo Técnico Real</h3>
                    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                        Mi título de Analista Programadora y experiencia en Java Backend, Node.js y Python garantizan un entendimiento profundo del funcionamiento interno de los modelos de IA y sus limitaciones.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="p-6 rounded-2xl glass-panel shadow-sm hover:shadow-md transition-shadow space-y-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-300 flex items-center justify-center font-bold">
                        03
                    </div>
                    <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">Enfoque 100% Aplicado</h3>
                    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                        Clases virtuales dinámicas enfocadas en resultados: creación de rúbricas rápidas, adaptaciones curriculares para necesidades diversas y gemas/asistentes contextuales para materias de primaria.
                    </p>
                </div>
            </div>
        </section>

        <!-- Interactive AI Tool Preview for Primary School Teachers -->
        <section id="simulador" class="p-6 sm:p-8 rounded-3xl bg-slate-900 text-white shadow-xl border border-slate-800 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Demostración Interactiva de Clases</span>
                    <h2 class="text-xl sm:text-2xl font-bold mt-1">Generador de Prompts Didácticos para Primaria</h2>
                    <p class="text-xs sm:text-sm text-slate-400">Ejemplo de la metodología práctica que enseño a los docentes en mis talleres</p>
                </div>
                <div class="px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-medium self-start sm:self-auto">
                    Simulación Práctica
                </div>
            </div>

            <!-- Simulator UI -->
            <div class="grid md:grid-cols-12 gap-6">
                <!-- Controls -->
                <div class="md:col-span-5 space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1.5">Materia / Área Primaria</label>
                        <select id="sim-materia" onchange="updatePromptSim()" class="w-full px-3 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm focus:outline-none focus:border-orange-500">
                            <option value="ciencias">Ciencias Naturales (4° a 6° grado)</option>
                            <option value="lengua">Lengua y Literatura (1° a 3° grado)</option>
                            <option value="matematica">Matemática Didáctica (5° grado)</option>
                            <option value="historia">Ciencias Sociales / Efemérides</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1.5">Objetivo Pedagógico</label>
                        <select id="sim-objetivo" onchange="updatePromptSim()" class="w-full px-3 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-sm focus:outline-none focus:border-orange-500">
                            <option value="cuento">Cuento interactivo adaptado</option>
                            <option value="rubrica">Rúbrica de evaluación rápida</option>
                            <option value="actividad">Juego de preguntas tipo trivia</option>
                            <option value="adaptacion">Adaptación curricular (Inclusión)</option>
                        </select>
                    </div>

                    <div class="p-3 rounded-xl bg-slate-800/60 border border-slate-700/60 text-xs text-slate-300 space-y-1.5">
                        <span class="font-semibold text-emerald-400 block">💡 Tip Didáctico que enseño:</span>
                        <p id="sim-tip">El Prompt debe incluir el rol del bot, la edad exacta de los alumnos y el formato deseado para evitar respuestas genéricas.</p>
                    </div>
                </div>

                <!-- Result Box -->
                <div class="md:col-span-7 flex flex-col justify-between bg-slate-950 p-4 rounded-2xl border border-slate-800">
                    <div class="space-y-2">
                        <div class="flex items-center justify-between text-xs text-slate-400 border-b border-slate-800 pb-2">
                            <span class="font-mono text-emerald-400">Prompt Estructurado Generado:</span>
                            <span class="bg-orange-950 text-orange-300 px-2 py-0.5 rounded text-[10px]">NotebookLM / Gemini Ready</span>
                        </div>
                        <div id="sim-output" class="font-mono text-xs sm:text-sm text-slate-200 leading-relaxed whitespace-pre-line p-2 min-h-[160px] overflow-x-auto">
                            <!-- JavaScript populates this -->
                        </div>
